# Required for the chat API. Never commit a real key.
LLM_API_KEY=sk-...

# OpenAI-compatible base URL (no trailing slash). Defaults to OpenAI.
# Examples:
#   https://api.openai.com/v1
#   https://api.groq.com/openai/v1
#   http://localhost:18990/v1   (local mock for tests)
LLM_BASE_URL=https://api.openai.com/v1

# Model id accepted by that provider.
LLM_MODEL=gpt-4o-mini

# Port for `npm run server` (Vite proxies /api here in dev).
PORT=8787

# Mock LLM (npm run mock-llm)
MOCK_LLM_PORT=18990

# --- Commerce / POS ---
# COMMERCE_PROVIDER=mock|quickvee
# Default: "quickvee" when QUICKVEE_API_KEY is set, otherwise "mock" (dev sample data).
# COMMERCE_PROVIDER=mock

# Quickvee (production POS). Endpoints used:
#   GET {QUICKVEE_BASE_URL}/inventory
#   GET {QUICKVEE_BASE_URL}/orders?order_number=...
QUICKVEE_BASE_URL=https://quickvee.com
QUICKVEE_API_KEY=
# Optional store/merchant id appended as merchant_id query param
QUICKVEE_MERCHANT_ID=
# Auth header name (default Authorization) and scheme bearer|raw
QUICKVEE_AUTH_HEADER=Authorization
QUICKVEE_AUTH_SCHEME=bearer
QUICKVEE_TIMEOUT_MS=8000

# Local fake Quickvee (npm run mock-quickvee) — ASSUMED response shapes for tests
# MOCK_QUICKVEE_PORT=18991
# QUICKVEE_BASE_URL=http://localhost:18991
# QUICKVEE_API_KEY=test
# COMMERCE_PROVIDER=quickvee

# --- RAG tuning ---
# RAG_CHUNK_CHARS=1200
# RAG_CHUNK_OVERLAP=150
# RAG_MAX_CONTEXT_CHARS=6000
# Optional embeddings are NOT enabled by default (keyword BM25 only).
# RAG_USE_EMBEDDINGS=0
